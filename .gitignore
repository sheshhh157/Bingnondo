# Stale copy of the backend tree that predates backend/ and cannot run: it is
# missing the modules its own server.js imports and has no package.json.
# Kept on disk only in case it holds something worth recovering; ignoring it
# stops a future `git add .` from committing files that shadow the real ones.
# The tracked ESP32 files (.ino, SETUP.md, secrets.example.h, seed_esp32_device.sql)
# sit outside this directory and stay tracked.
/esp32-buzzer/esp32-buzzer/backend/

# Schema-only dumps (75 CREATE statements, no rows). Not read by the app.
# Regenerate with pg_dump --schema-only when needed.
/all_tables.sql
/bingnondo_schema_live.sql

# Local layout/snapshot probes that drive a headless browser against localhost
# for UI verification. These are development tools, not app code, so they must
# stay out of the repo. The tracked scripts/ files (measure.mjs,
# screenshot.mjs, seed-demo-orders.sql) do not match these patterns and are
# unaffected.
scripts/probe-*.mjs
scripts/shot-*.mjs

# Kept on disk locally but excluded from this branch: repo-level attributes,
# CI, and the design/database reference docs. They remain in the working tree
# as untracked files; this keeps them out of the pushed tree and stops a
# future `git add .` from re-adding them.
/.gitattributes
/.github/
/bingnondo_architecture_design.md
/bingnondo_database.sql
/bingnondo_flow.md
