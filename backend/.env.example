NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase: paste the PostgreSQL connection string from Project Settings → Database.
# Use the Session pooler URL if the host only supports IPv4.
# Keep the password private; never commit your real .env file.
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Local database fallback (used when DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bingnondo_db
DB_USER=postgres
DB_PASSWORD=your_db_password

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# ── Email delivery ──────────────────────────────────────────────────────────
# Development: leave SMTP_HOST empty → Ethereal catches all mail and prints a
# preview URL to the backend console (NOTHING is actually delivered).
#
# Real delivery — fill all five SMTP values:
#   Gmail: enable 2FA, create an App Password (not your account password), then:
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=465
#     SMTP_SECURE=true
#     SMTP_USER=<sender>@gmail.com
#     SMTP_PASS=<16-character app password — spaces are fine, they are stripped>
#   Brevo (300 emails/day free):
#     SMTP_HOST=smtp-relay.brevo.com
#     SMTP_PORT=587
#     SMTP_SECURE=true
#
# MAIL_FROM must be the real sender address you authenticate with — a domain
# you do not own (e.g. noreply@bingnondo.com) lands in spam.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bingnondo Cafe <noreply@bingnondo.com>"

# ── ESP32 Wi‑Fi config ────────────────────────────────────────────────────────
# These values are only examples; replace them with real secrets before production.
ESP32_DEVICE_KEY=change_me_shared_device_key
ESP32_DEVICE_CODE=ESP32-KitchenA
ESP32_CONFIG_SECRET=replace_with_64_hex_chars
