NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bingnondo
DB_USER=postgres
DB_PASSWORD=your_password_here
# DATABASE_URL=postgres://user:password@localhost:5432/bingnondo

# Database used when NODE_ENV=test. The test suite refuses to run against
# DB_NAME, and npm run migrate refuses when NODE_ENV=test targets DB_NAME.
# The Postgres user needs CREATEDB so `npm run test:setup` can create it (or
# create that database yourself first — migrate then treats it as missing).
# DB_NAME_TEST=bingnondo_test

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bingnondo Cafe <noreply@bingnondo.com>"

# ESP32 buzzer credentials.
# Generate ESP32_DEVICE_KEY with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ESP32_DEVICE_KEY=generate_a_long_random_hex_string_here
ESP32_DEVICE_CODE=ESP32-KitchenA
UNPAID_ORDER_TIMEOUT_MIN=30
