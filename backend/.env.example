NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase: paste the PostgreSQL connection string from Project Settings → Database.
# Use the Session pooler URL if the host only supports IPv4.
# Keep the password private; never commit your real .env file.
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Local database fallback (used when DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bingnondo_db
DB_USER=postgres
DB_PASSWORD=your_db_password

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# ── Email delivery ──────────────────────────────────────────────────────────
# Development: leave BREVO_API_KEY and SMTP_HOST empty → Ethereal catches all
# mail and prints a preview URL to the backend console (NOTHING is delivered).
#
# Railway Free/Trial/Hobby: use Brevo's HTTPS API (recommended):
#   BREVO_API_KEY=<Brevo API key; starts with xkeysib->
#   MAIL_FROM="Bingnondo Cafe <verified-sender@your-domain.com>"
# The sender must be verified in Brevo. Store BREVO_API_KEY in Railway's
# backend service Variables; never commit it to this file.
#
# Real delivery via SMTP (only on hosts/plans that allow outbound SMTP):
#   Gmail: enable 2FA, create an App Password (not your account password), then:
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=465
#     SMTP_SECURE=true
#     SMTP_USER=<sender>@gmail.com
#     SMTP_PASS=<16-character app password — spaces are fine, they are stripped>
# MAIL_FROM must be an address you have verified with your email provider.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bingnondo Cafe <verified-sender@your-domain.com>"

# ── ESP32 Wi‑Fi config ────────────────────────────────────────────────────────
# These values are only examples; replace them with real secrets before production.
ESP32_DEVICE_KEY=change_me_shared_device_key
ESP32_DEVICE_CODE=ESP32-KitchenA
ESP32_CONFIG_SECRET=replace_with_64_hex_chars
